// single-line, no sorting needed
a = new Foo { a = 1; b = 2 }

// single-line, needs sorting
b = new Foo { z = 3; a = 1; m = 2 }

// multiline, needs sorting
c = new Foo {
  z = 3
  a = 1
  m = 2
}

// annotation with multiple keyword arguments, needs sorting
@Bar { z = 3; a = 1; m = 2 }
d = 1

// not a pure property body (has element), no sorting
e = new Dynamic { 1; z = 3; a = 1 }

// single property, no change needed
f = new Foo { a = 1 }

// with leading and trailing comments
g = new Foo {
  // leading z
  z = 3 // trailing z
  // leading a
  a = 1 // trailing a
}

// annotation single-line, needs sorting
@Qux { zoo = "last"; apple = "first"; mango = "middle" }
h = 1

// multiline with blank lines between properties
i = new Foo {
  z = 3

  a = 1

  m = 2
}
